{
  "manifest_version": 3,
  "name": "闲鱼商品监控",
  "version": "1.1.1",
  "minimum_chrome_version": "120",
  "description": "读取已登录闲鱼搜索页的商品，在匹配时通知专用飞书群。",
  "permissions": ["alarms", "storage"],
  "host_permissions": ["https://www.goofish.com/*", "https://open.feishu.cn/*"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [{"matches": ["https://www.goofish.com/search*"], "js": ["reader.js"], "run_at": "document_idle"}],
  "options_page": "options.html",
  "action": {"default_title": "打开闲鱼商品监控"}
}
